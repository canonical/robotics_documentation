      "npm": "@ai-sdk/openai-compatible",
      "name": "Inference Snaps",
      "options": {
        "baseURL": "http://127.0.0.1:8336/v1",
        "apiKey": "none"
      },
      "models": {
        "gemma4-e2b-q4-k-m": {
          "name": "Gemma 4 E2B"
        },
        "gemma4-e4b-q4-k-m": {
          "name": "Gemma 4 E4B"
        },
        "gemma4-26b-a4b-q4-k-m": {
          "name": "Gemma 4 26B"
        }
      }
    }
  },
  "model": "inference-snaps/gemma4-e4b-q4-k-m"
}
EOF
